# Puerto HTTP de la API
PORT=8787
# Rol api_service: SELECT/INSERT/UPDATE/DELETE en public y SELECT (id, email, created_at) en auth.users
DATABASE_URL=postgres://api_service:postgres@localhost:5432/postgres
# Secreto HS256 con el que GoTrue firma las sesiones (JWT_SECRET de docker/.env)
SUPABASE_JWT_SECRET=
# Base de los enlaces de los correos (sin barra final)
APP_URL=http://localhost:8080
# Gmail (contraseña de aplicación). Sin ellos la API responde mailed: false y guarda los datos igual.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# true detrás de Kong/Caddy: toma la IP real de X-Forwarded-For
TRUST_PROXY=true
# Orígenes CORS separados por coma; * en desarrollo
CORS_ORIGINS=*
