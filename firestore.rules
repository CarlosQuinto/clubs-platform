rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function platformConfig() {
      return get(/databases/$(database)/documents/platform/config);
    }

    function platformExists() {
      return exists(/databases/$(database)/documents/platform/config);
    }

    function isSuperAdmin() {
      return signedIn()
        && platformExists()
        && request.auth.uid in platformConfig().data.superAdmins;
    }

    function memberPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    function isMember(clubId) {
      return signedIn() && exists(memberPath(clubId));
    }

    function memberRole(clubId) {
      return get(memberPath(clubId)).data.role;
    }

    function hasRole(clubId, roles) {
      return isSuperAdmin() || (isMember(clubId) && memberRole(clubId) in roles);
    }

    function isClubAdmin(clubId) {
      return hasRole(clubId, ['admin']);
    }

    function emailKeyOf(email) {
      return email.lower().replace('\\.', ',');
    }

    function claimingPlatformInvite() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/platform/config/invites/$(emailKeyOf(request.auth.token.email)))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['superAdmins', 'superAdminEmails', 'updatedAt'])
        && request.auth.uid in request.resource.data.superAdmins
        && !(request.auth.uid in resource.data.superAdmins)
        && request.resource.data.superAdmins.size() == resource.data.superAdmins.size() + 1
        && request.resource.data.superAdmins.hasAll(resource.data.superAdmins);
    }

    // ---------- Plataforma ----------
    match /platform/config {
      allow read: if true;
      // El primer usuario autenticado reclama la plataforma.
      allow create: if signedIn()
        && request.resource.data.superAdmins is list
        && request.resource.data.superAdmins.size() == 1
        && request.resource.data.superAdmins[0] == request.auth.uid;
      // Solo los superadmins actuales pueden modificarla; nunca borrar.
      // Un invitado puede agregarse a sí mismo si existe platform/config/invites/{email}.
      allow update: if (
          isSuperAdmin()
          && request.resource.data.superAdmins is list
          && request.resource.data.superAdmins.size() >= 1
        )
        || claimingPlatformInvite();
      allow delete: if false;

      match /invites/{inviteKey} {
        allow read: if isSuperAdmin()
          || (
            signedIn()
            && request.auth.token.email != null
            && inviteKey == emailKeyOf(request.auth.token.email)
          );
        allow create, update: if isSuperAdmin()
          && request.resource.data.email is string
          && inviteKey == emailKeyOf(request.resource.data.email);
        allow delete: if isSuperAdmin()
          || (
            signedIn()
            && request.auth.token.email != null
            && inviteKey == emailKeyOf(request.auth.token.email)
          );
      }
    }

    match /localities/{localityId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /seasons/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /tournaments/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /notices/{clubId} {
        allow read, write: if false;
      }
    }

    match /courts/{id} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'hourlyRate', 'active', 'order', 'imageUrl', 'football'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 15
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 15
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 0
        && request.resource.data.hourlyRate < 1000000
        && request.resource.data.active is bool
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order < 1000
        && (
          !('imageUrl' in request.resource.data)
          || (
            request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() < 2000
          )
        )
        && (
          !('football' in request.resource.data)
          || request.resource.data.football is bool
        );
      allow delete: if isSuperAdmin();
    }

    match /courtHolds/{id} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          'courtId', 'date', 'startTime', 'endTime', 'source', 'note'
        ])
        && request.resource.data.source == 'manual'
        && request.resource.data.courtId is string
        && request.resource.data.courtId.size() > 0
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.note is string
        && request.resource.data.note.size() < 200;
      allow delete: if isSuperAdmin();
    }

    match /matches/{id} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      // Superadmin edita todo. El DT/presidente de local o visita
      // solo registra asistencia y alineación de su lado, no marcador ni stats.
      allow update: if isSuperAdmin()
        || (
          signedIn()
          && (
            hasRole(resource.data.homeClubId, ['admin', 'dt'])
            || hasRole(resource.data.awayClubId, ['admin', 'dt'])
          )
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['sides', 'updatedAt'])
          && request.resource.data.get('homeScore', null)
              == resource.data.get('homeScore', null)
          && request.resource.data.get('awayScore', null)
              == resource.data.get('awayScore', null)
          && request.resource.data.get('penaltiesHome', null)
              == resource.data.get('penaltiesHome', null)
          && request.resource.data.get('penaltiesAway', null)
              == resource.data.get('penaltiesAway', null)
          && request.resource.data.status == resource.data.status
        );
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /mail/{id} {
      allow read, write: if false;
    }

    // Índice público para /registro: existe si el correo fue invitado.
    match /signupInvites/{inviteKey} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if request.resource.data.email is string
        && inviteKey == emailKeyOf(request.resource.data.email)
        && (
          isSuperAdmin()
          || (
            request.resource.data.clubId is string
            && isClubAdmin(request.resource.data.clubId)
            && request.resource.data.get('platform', false) == false
          )
        );
      allow delete: if isSuperAdmin()
        || (
          resource.data.clubId is string
          && isClubAdmin(resource.data.clubId)
        );
    }

    match /inquiries/{id} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if request.resource.data.keys()
          .hasOnly(['name', 'email', 'phone', 'message', 'topic', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() < 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 6
        && request.resource.data.phone.size() < 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 2
        && request.resource.data.message.size() < 2000
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 1
        && request.resource.data.topic.size() < 80
        && request.resource.data.createdAt == request.time;
    }

    function isIsoDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validAdHref(value) {
      return value is string
        && value.size() < 500
        && (
          value.size() == 0
          || value.matches('^https://.+$')
          || value.matches('^http://.+$')
        );
    }

    function validAd() {
      return request.resource.data.keys().hasOnly([
          'brand', 'imageUrl', 'href', 'placements', 'startsAt', 'endsAt',
          'active', 'order', 'createdAt'
        ])
        && request.resource.data.brand is string
        && request.resource.data.brand.size() > 0
        && request.resource.data.brand.size() < 80
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 8
        && request.resource.data.imageUrl.size() < 2000
        && (
          request.resource.data.imageUrl.matches('^https://.+$')
          || request.resource.data.imageUrl.matches('^http://.+$')
        )
        && validAdHref(request.resource.data.href)
        && request.resource.data.placements is list
        && request.resource.data.placements.size() > 0
        && request.resource.data.placements.size() <= 4
        && request.resource.data.placements.hasOnly([
          'home', 'tournament', 'club', 'teams'
        ])
        && isIsoDate(request.resource.data.startsAt)
        && isIsoDate(request.resource.data.endsAt)
        && request.resource.data.startsAt <= request.resource.data.endsAt
        && request.resource.data.active is bool
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order < 1000
        && request.resource.data.createdAt is timestamp;
    }

    match /ads/{id} {
      allow read: if true;
      allow create: if isSuperAdmin()
        && validAd()
        && request.resource.data.createdAt == request.time;
      allow update: if isSuperAdmin()
        && validAd()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSuperAdmin();
    }

    match /teamApplications/{id} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if request.resource.data.keys()
          .hasOnly(['captainName', 'captainEmail', 'captainPhone', 'teamName', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.captainName is string
        && request.resource.data.captainName.size() > 1
        && request.resource.data.captainName.size() < 120
        && request.resource.data.captainEmail is string
        && request.resource.data.captainEmail.size() > 3
        && request.resource.data.captainEmail.size() < 120
        && request.resource.data.captainPhone is string
        && request.resource.data.captainPhone.size() > 6
        && request.resource.data.captainPhone.size() < 30
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() > 1
        && request.resource.data.teamName.size() < 80
        && request.resource.data.createdAt == request.time;
    }

    // ---------- Clubes ----------
    match /clubs/{clubId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      // Presidente/Prensa editan portada e identidad; DT guarda alineaciones base.
      allow update: if isSuperAdmin()
        || (
          isClubAdmin(clubId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'logoUrl', 'description', 'location', 'presidentPhone', 'heroImages', 'defaultLineups', 'updatedAt'])
        )
        || (
          hasRole(clubId, ['prensa'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'description', 'location', 'heroImages', 'updatedAt'])
        )
        || (
          hasRole(clubId, ['dt'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['defaultLineups', 'updatedAt'])
        );

      // Miembros del club (uid -> rol)
      match /members/{uid} {
        // Cada miembro ve su propio doc; el presidente ve la lista completa.
        allow read: if signedIn() && (request.auth.uid == uid || isClubAdmin(clubId));
        allow create: if isClubAdmin(clubId)
          || (
            // Autoreclamo solo si la invitación es de alta (kind != accept).
            // Quien ya tiene cuenta debe aceptar el rol desde /invitar.
            signedIn()
            && request.auth.uid == uid
            && request.auth.token.email != null
            && exists(/databases/$(database)/documents/clubs/$(clubId)/invites/$(emailKeyOf(request.auth.token.email)))
            && get(/databases/$(database)/documents/clubs/$(clubId)/invites/$(emailKeyOf(request.auth.token.email))).data.get('kind', 'signup') != 'accept'
            && request.resource.data.role ==
              get(/databases/$(database)/documents/clubs/$(clubId)/invites/$(emailKeyOf(request.auth.token.email))).data.role
          );
        allow update, delete: if isClubAdmin(clubId);
      }

      // Invitaciones pendientes (clave = correo normalizado)
      match /invites/{inviteKey} {
        allow read: if isClubAdmin(clubId)
          || (
            signedIn()
            && request.auth.token.email != null
            && inviteKey == emailKeyOf(request.auth.token.email)
          );
        allow create, update: if isClubAdmin(clubId)
          && request.resource.data.role in ['admin', 'dt', 'prensa', 'tesorero'];
        allow delete: if isClubAdmin(clubId)
          || (
            signedIn()
            && request.auth.token.email != null
            && inviteKey == emailKeyOf(request.auth.token.email)
          );
      }

      // Datos deportivos
      match /players/{id} {
        allow read: if true;
        allow create, delete: if hasRole(clubId, ['admin', 'dt']);
        // Tesorero actualiza lifetime_contributions al registrar aportaciones.
        allow update: if hasRole(clubId, ['admin', 'dt'])
          || (
            hasRole(clubId, ['tesorero'])
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lifetime_contributions'])
          );
      }

      match /events/{id} {
        allow read: if true;
        allow write: if hasRole(clubId, ['admin', 'dt']);
      }

      match /transactions/{id} {
        allow read: if true;
        allow write: if hasRole(clubId, ['admin', 'tesorero'])
          // DT solo registra la recaudación de arbitraje desde la agenda (arb_{eventId}).
          || (hasRole(clubId, ['dt']) && id.matches('arb_.*'));
      }

      match /goals/{id} {
        allow read: if true;
        allow write: if hasRole(clubId, ['admin', 'tesorero']);
      }

      match /inventory/{id} {
        allow read: if true;
        allow write: if hasRole(clubId, ['admin', 'dt', 'tesorero']);
      }

      match /gallery/{id} {
        allow read: if true;
        allow write: if hasRole(clubId, ['admin', 'prensa']);
      }

      match /availability/{id} {
        allow read: if isSuperAdmin() || hasRole(clubId, ['admin', 'dt']);
        allow write: if id == 'windows'
          && (isSuperAdmin() || hasRole(clubId, ['admin', 'dt']))
          && request.resource.data.keys().hasOnly(['windows', 'updatedAt', 'updatedBy'])
          && request.resource.data.windows is list
          && request.resource.data.windows.size() <= 21;
      }
    }
  }
}
