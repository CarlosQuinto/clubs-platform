# Copia este archivo a `.env`. Los valores los imprime `npm run docker:env` al crear docker/.env.
# URL pública del gateway (Kong) de Supabase. En producción con un solo dominio: https://tu-dominio/api
VITE_SUPABASE_URL=http://localhost:8000
# Clave anon (JWT firmado con el JWT_SECRET de docker/.env)
VITE_SUPABASE_ANON_KEY=
# API de correo e invitaciones; opcional, por defecto ${VITE_SUPABASE_URL}/fn
VITE_API_URL=
