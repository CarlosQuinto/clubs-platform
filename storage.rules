rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    // Lectura pública. Escritura: sesión + imagen < 5 MB.
    // Quién puede asociar la imagen al club lo decide la mutación de Data Connect que guarda la URL.
    function canWrite() {
      return signedIn() && (request.resource == null || isImage());
    }

    function isCourtPhoto() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /platform/courts/{file} {
      allow read: if true;
      allow write: if signedIn() && (request.resource == null || isCourtPhoto());
    }

    // Las reglas se suman: courts queda fuera para que solo valga isCourtPhoto.
    match /platform/{folder}/{file} {
      allow read: if true;
      allow write: if folder != 'courts' && canWrite();
    }

    match /clubs/{clubId}/logos/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/portada/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/gallery/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/players/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/events/{file} {
      allow read: if true;
      allow write: if canWrite();
    }
  }
}
