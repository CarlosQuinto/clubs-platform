rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    // Lectura pública. Escritura: sesión + imagen < 5 MB.
    // Quién puede guardar logo/portada/galería en el club sigue en firestore.rules.
    // No usamos firestore.get aquí: en buckets nuevos suele devolver 403.
    function canWrite() {
      return signedIn() && (request.resource == null || isImage());
    }

    match /platform/{folder}/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/logos/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/portada/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/gallery/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/players/{file} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /clubs/{clubId}/events/{file} {
      allow read: if true;
      allow write: if canWrite();
    }
  }
}
