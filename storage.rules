rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function platformDoc() {
      return firestore.get(/databases/(default)/documents/platform/config);
    }

    function isSuperAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/platform/config)
        && request.auth.uid in platformDoc().data.superAdmins;
    }

    function memberRole(clubId) {
      return firestore.get(/databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role;
    }

    function hasRole(clubId, roles) {
      return isSuperAdmin()
        || (
          signedIn()
          && firestore.exists(/databases/(default)/documents/clubs/$(clubId)/members/$(request.auth.uid))
          && memberRole(clubId) in roles
        );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /clubs/{clubId}/logos/{file} {
      allow read: if true;
      allow write: if hasRole(clubId, ['admin']) && (request.resource == null || isImage());
    }

    match /clubs/{clubId}/portada/{file} {
      allow read: if true;
      allow write: if hasRole(clubId, ['admin', 'prensa']) && (request.resource == null || isImage());
    }

    match /clubs/{clubId}/gallery/{file} {
      allow read: if true;
      allow write: if hasRole(clubId, ['admin', 'prensa']) && (request.resource == null || isImage());
    }

    match /clubs/{clubId}/players/{file} {
      allow read: if true;
      allow write: if hasRole(clubId, ['admin', 'dt']) && (request.resource == null || isImage());
    }

    match /clubs/{clubId}/events/{file} {
      allow read: if true;
      allow write: if hasRole(clubId, ['admin', 'dt', 'prensa']) && (request.resource == null || isImage());
    }
  }
}
