# HTTPS automático (Let's Encrypt) para DOMAIN y, si los hay, los subdominios de EXTRA_DOMAINS
# (separados por espacios; cada uno saca su propio certificado). Todo va al frontend (nginx),
# que sirve la SPA y reenvía /api/* al gateway (Kong): auth, rest, storage, fn y Studio.
{$DOMAIN} {$EXTRA_DOMAINS} {
	encode gzip
	reverse_proxy web:80
}
