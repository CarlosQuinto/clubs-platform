# Variables del stack Docker (docker/docker-compose.yml). No lo edites a mano la primera vez:
#   npm run docker:env
# crea docker/.env con secretos y claves nuevas a partir de esta plantilla (los valores __GENERAR__),
# e imprime las VITE_* que van en el .env de la raíz.

############
# Secretos #
############

POSTGRES_PASSWORD=__GENERAR__
JWT_SECRET=__GENERAR__
# JWT firmados con JWT_SECRET para los roles anon y service_role (los genera docker:env)
ANON_KEY=__GENERAR__
SERVICE_ROLE_KEY=__GENERAR__
# Acceso a Studio (http://localhost:8000)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=__GENERAR__
PG_META_CRYPTO_KEY=__GENERAR__

############
# URLs     #
############

# Solo producción (docker-compose.prod.yml): dominio que Caddy publica con HTTPS, sin https:// (p. ej. liga.ejemplo.com)
DOMAIN=
# Solo producción: subdominios extra que Caddy también publica, separados por espacios (p. ej. demo.liga.ejemplo.com).
# El DNS de cada uno debe apuntar al servidor (o un registro comodín *.DOMAIN)
EXTRA_DOMAINS=

# URL pública del gateway (Kong). En producción con un solo dominio: https://tu-dominio/api
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# URL del frontend (enlaces de los correos). Dev: Vite en 5173. Producción: https://tu-dominio
SITE_URL=http://localhost:5173
# Destinos permitidos tras verificar un enlace de correo (restablecer contraseña)
ADDITIONAL_REDIRECT_URLS=http://localhost:5173/**,http://localhost:8080/**
# Base de la API de correo para el frontend; vacío = ${SUPABASE_PUBLIC_URL}/fn
VITE_API_URL=

############
# Correo   #
############

# Restablecer contraseña (GoTrue). Con Gmail: smtp.gmail.com, 465, tu correo y una contraseña de aplicación.
# Si el proveedor bloquea el 465 (Hetzner en cuentas nuevas), usa 587.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Clubs Platform
# Invitaciones y avisos (api/). Sin ellos, la API guarda los datos y responde mailed: false.
GMAIL_USER=
GMAIL_APP_PASSWORD=

############
# Puertos  #
############

KONG_HTTP_PORT=8000
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8787
WEB_HOST_PORT=8080
JWT_EXPIRY=3600

############
# Varios   #
############

# true: el servicio migrate carga db/seed/*.sql y scripts/demo/demo-seed.sql
DB_SEED=true
# Orígenes CORS de la API de correo (coma); * en desarrollo
CORS_ORIGINS=*
# true si la API está detrás de Kong/Caddy (lee la IP real de X-Forwarded-For)
TRUST_PROXY=true
